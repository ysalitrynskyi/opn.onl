# ===========================================
# BACKEND CONFIGURATION - opn.onl
# ===========================================
# Copy this file to .env and fill in your values

# Database (Required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opn_onl

# JWT Secret (REQUIRED) - generate a unique value with `openssl rand -base64 64`.
# This template intentionally leaves it empty; the server refuses to start.
JWT_SECRET=

# Server Configuration (the server always listens on 0.0.0.0)
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# HTTPS Redirect (set to "true" in production behind reverse proxy)
FORCE_HTTPS=false

# Trust forwarding headers for the client IP used in rate limiting and click
# analytics. Set to "true" ONLY when running behind a trusted reverse proxy
# (Cloudflare Tunnel, nginx, etc.). When false (default), the real socket peer
# IP is used and all forwarding headers are ignored — correct for direct
# exposure, but behind a proxy it collapses all visitors into one bucket.
TRUST_PROXY_HEADERS=false

# Which header the trusted edge sets to the real client IP. Default:
# cf-connecting-ip (Cloudflare sets it authoritatively; clients cannot forge
# it through Cloudflare). Set to "none" to disable if not behind Cloudflare, or
# to x-real-ip if a trusted nginx overwrites that header with $remote_addr.
# Use "none" rather than an empty value: the compose files turn an empty value
# back into the Cloudflare default.
# REAL_IP_HEADER=cf-connecting-ip

# X-Forwarded-For fallback when REAL_IP_HEADER is unset/absent: number of
# trailing XFF entries appended by additional trusted proxies. 0 (default) =
# use the right-most entry. The first/left-most XFF entries are client-
# controlled and are never used.
# TRUSTED_PROXY_HOPS=0

# Logging
RUST_LOG=info,tower_http=info
LOG_DIR=logs
# Daily log files kept in LOG_DIR; older ones are deleted. 0 keeps all of them.
# LOG_MAX_FILES=14

# ===========================================
# LINK MANAGEMENT
# ===========================================

# Every on/off switch below (ENABLE_*, BLOCK_*) accepts true or false, also
# written 1/0, yes/no or on/off, in any case. Anything else is ignored with a
# warning in the log and the default applies.

# Allow custom aliases (default: true)
ENABLE_CUSTOM_ALIASES=true

# Alias length constraints (letters, digits, hyphens, underscores). Without
# these the backend allows 5 to 50 characters; the values below are what the
# Compose files ship.
MIN_ALIAS_LENGTH=5
MAX_ALIAS_LENGTH=25

# URL sanitization (default: true)
ENABLE_URL_SANITIZATION=true

# Abuse guards on link destinations (both default: true — recommended for any
# public instance). Independent of ENABLE_URL_SANITIZATION.
#   BLOCK_DANGEROUS_FILE_EXTENSIONS — refuse to shorten links that point directly
#     at an executable/script/installer file (.hta, .exe, .scr, .js, .msi, .jar,
#     .apk, .dmg, .iso, …). These are a common malware-delivery vector and have
#     no legitimate use behind a short link.
#   BLOCK_RAW_IP_URLS — refuse to shorten links whose host is a bare IP address
#     (no domain). Strong abuse signal on a public shortener; self-hosters who
#     legitimately shorten internal/LAN IPs can set this to false.
BLOCK_DANGEROUS_FILE_EXTENSIONS=true
BLOCK_RAW_IP_URLS=true

# Branded QR codes — brand colour, centre logo, SVG export (default: true,
# kill-switch only). When false, /links/{id}/qr serves a plain B/W PNG.
ENABLE_QR_BRANDING=true

# Burn-after-reading — one-time / self-destruct links (default: true; per-link opt-in).
ENABLE_BURN_AFTER_READING=true

# Safe-link interstitial — destination preview + reputation before redirecting,
# on opted-in links (default: true; per-link opt-in).
ENABLE_SAFE_LINK_INTERSTITIAL=true

# Smart conditional routing — device/OS/country/language + weighted A/B (default: true).
ENABLE_CONDITIONAL_ROUTING=true

# Link-in-bio — public profile page at /@username (default: true; per-user opt-in).
ENABLE_LINK_IN_BIO=true

# API keys — personal access tokens for the MCP server / API clients (default: true).
ENABLE_API_KEYS=true

# Account deletion (default: false). Note for GDPR-style compliance: if you
# keep this off, you must honor deletion requests manually (see privacy@).
ENABLE_ACCOUNT_DELETION=false

# Days a deleted account (self-deleted or removed by an admin) is kept before a
# daily sweep removes it for good: the user, their links, click history,
# passkeys and API keys. An admin can restore it until then. Default 30.
# A link deleted on its own is removed for good after the same window.
# Set to 0 to keep deleted accounts and links until an admin removes them.
# ACCOUNT_PURGE_DAYS=30

# Analytics PII retention, in days (default: 396 ≈ 13 months). A daily sweep
# anonymizes per-visitor identifiers (truncated IP, raw user agent) on click
# events older than this, and the truncated IP on organization audit entries;
# aggregate analytics (country, city, device, browser, referrer) and the audit
# entries themselves are kept. Set to 0 to disable the sweep entirely.
# ANALYTICS_PII_RETENTION_DAYS=396

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Redis Cache (Optional - improves redirect performance)
# REDIS_URL=redis://localhost:6379
# REDIS_CACHE_TTL=300

# Email Service (Optional - required for email verification & contact form;
# without it the contact form answers 503 rather than dropping messages)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_TLS=starttls  # starttls, tls, or none
# SMTP_FROM_EMAIL=noreply@opn.onl
# SMTP_FROM_NAME=opn.onl
# Empty SMTP_HOST, SMTP_USER or SMTP_PASS count as not set.
# Default true. Set to false only if your instance has no SMTP; anyone can
# then sign up with an address they do not own. Missing SMTP does not turn this off.
# REQUIRE_EMAIL_VERIFICATION=true
# Once a day, email each owner the personal links that expire within the next
# 3 days (at most 20 per email; organization links are not included). Users can
# turn it off in Settings. Default true; needs SMTP. Set to false to send none.
# LINK_EXPIRY_REMINDERS=true
# Allow POST /links without credentials (an anonymous link nobody owns, and a
# common way to hide phishing links). Default false: the API needs a sign-in
# token or an API key. The web app always requires an account.
# ALLOW_ANONYMOUS_LINKS=false

# Contact form recipient. There is no default: while unset, the contact form
# answers 503 and mails nobody.
# ADMIN_EMAIL=you@example.com

# S3 Backup (Optional - for automated database backups). With the four
# BACKUP_S3_* values set, the backend backs the database up on a schedule and
# prunes old copies.
# BACKUP_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=opn-backups
# BACKUP_S3_ACCESS_KEY=your-access-key
# BACKUP_S3_SECRET_KEY=your-secret-key
# BACKUP_S3_REGION=auto
# Hours between backups (default 24; 0 turns scheduled backups off). The first
# one runs this long after the backend starts, not at startup.
# BACKUP_INTERVAL_HOURS=24
# Automatic backups to keep: after each scheduled backup, all but the newest N
# automatic backups are deleted (default 14, minimum 1). Backups taken by hand
# from the admin panel are never deleted by the schedule.
# BACKUP_KEEP=14

# Click Event Batching (Optional - tune for performance)
# CLICK_BUFFER_SIZE=100
# CLICK_FLUSH_INTERVAL=10

# ===========================================
# GeoIP Database (Optional - for location analytics)
# ===========================================
# Sign up at https://www.maxmind.com/en/geolite2/signup
# MAXMIND_ACCOUNT_ID=123456
# MAXMIND_LICENSE_KEY=your-license-key

# ===========================================
# RATE LIMITING
# ===========================================

# Global email rate limit (prevents abuse/DDoS, controls costs)
# Maximum emails that can be sent per hour in total (default: 500). Split 60%
# account mail (verification, password reset, welcome), 20% security notices
# (password changed), 10% contact form and 10% link expiry reminders, so a
# flood of one kind cannot starve the others. Separately, an address is sent at most one verification and one
# reset email every 5 minutes (five of each a day), and one client IP can
# trigger at most 20 of these emails an hour; those two are fixed.
EMAIL_RATE_LIMIT_PER_HOUR=500

# Open /ws and /sse connections one account may hold at once, together
# (default: 5). 0 lifts the limit.
# WS_MAX_CONNECTIONS_PER_USER=5
