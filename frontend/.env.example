# Copy this file to .env and fill in your values

# Backend API URL (Required)
VITE_API_URL=http://localhost:3000

# Frontend URL (for SEO meta tags and short link display)
VITE_FRONTEND_URL=http://localhost:5173

# Note: Google Analytics is set at runtime via the GA_ID and GA_CONSENT_MODE env
# vars in docker-compose. Not needed for local development
