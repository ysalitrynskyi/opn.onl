# ===========================================
# FRONTEND CONFIGURATION - opn.onl
# ===========================================
# Copy this file to .env and fill in your values

# Backend API URL (Required)
VITE_API_URL=http://localhost:3000

# Frontend URL: the site's origin, no path (canonical URLs, sitemap.xml,
# robots.txt and short link display all come from it)
VITE_FRONTEND_URL=http://localhost:5173

# Note: Google Analytics is set at runtime via the GA_ID and GA_CONSENT_MODE env
# vars in docker-compose. Not needed for local development
